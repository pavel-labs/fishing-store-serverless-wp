{
  "regions": [
    "fra1"
  ],
  "routes": [
    {
      "src": "^/((?:wp-admin|wp-content|wp-includes)/.+)\\.(css|js|svg|png|gif|jpg|jpeg|webp|woff|woff2|ico|otf)$",
      "headers": {
        "Cache-Control": "max-age=864000, s-maxage=864000"
      },
      "continue": true
    },
    {
      "src": "^/((?:wp-admin|wp-content|wp-includes)/.+)\\.(css|js|svg|png|gif|jpg|jpeg|webp|woff|woff2|ico|otf)$",
      "dest": "/wp/$1.$2"
    },
    {
      "src": "^/(wp-admin|wp-includes|wp-content)$",
      "status": 308,
      "headers": {
        "Location": "/$1/"
      }
    },
    {
      "src": "/(.*)",
      "dest": "/api/vercel.js"
    }
  ],
  "functions": {
    "api/vercel.js": {
      "includeFiles": "{wp/**,node_modules/serverlesswp/php-files/**}",
      "maxDuration": 60
    }
  },
  "build": {
    "env": {
      "NODEJS_AWS_HANDLER_NAME": "handler"
    }
  },
  "installCommand": "npm ci",
  "buildCommand": "npm run security:php"
}
