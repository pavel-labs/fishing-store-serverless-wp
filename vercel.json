{
  "regions": ["fra1"],
  "routes": [
    {
      "src": "^/((?:wp-admin|wp-content|wp-includes)/.+)\\.(css|js|svg|png|gif|jpg|jpeg|webp|woff|woff2|ico|otf)$",
      "headers": {
        "Cache-Control": "max-age=864000, s-maxage=864000"
      },
      "continue": true
    },
    {
      "src": "^/((?:wp-admin|wp-content|wp-includes)/.+)\\.(css|js|svg|png|gif|jpg|jpeg|webp|woff|woff2|ico|otf)$",
      "dest": "/wp/$1.$2"
    },
    {
      "comment": "Apache and nginx redirect a directory request to its trailing-slash form; there is no filesystem here to do that. Without it the browser stays on /wp-admin, and the admin menu's relative links (admin.php?page=wc-orders) resolve against / instead of /wp-admin/, producing a 404 on every menu item.",
      "src": "^/(wp-admin|wp-includes|wp-content)$",
      "status": 308,
      "headers": {
        "Location": "/$1/"
      }
    },
    {
      "src": "/(.*)",
      "dest": "/api/vercel.js"
    }
  ],
  "functions": {
    "api/vercel.js": {
      "includeFiles": "wp/**",
      "maxDuration": 60
    }
  },
  "build": {
    "env": {
      "NODEJS_AWS_HANDLER_NAME": "handler"
    }
  }
}
